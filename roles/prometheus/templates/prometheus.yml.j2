# {{ ansible_managed }}
global:
  scrape_interval: 5s
  evaluation_interval: 5s

scrape_configs:
  - job_name: prometheus
    static_configs: [{ targets: ["127.0.0.1:9090"] }]
  - job_name: node
    static_configs: [{ targets: ["127.0.0.1:9100"] }]
  - job_name: dino
    static_configs: [{ targets: ["127.0.0.1:5000"] }]
