# {{ ansible_managed }}
global
    log /dev/log local0
    maxconn 512
    user haproxy
    group haproxy
    daemon

cache static
    total-max-size 64        # MB
    max-object-size 2000000  # bytes
    max-age 120              # seconds

defaults
    log     global
    mode    http
    option  httplog
    option  forwardfor
    timeout connect 5s
    timeout client  30s
    timeout server  30s

frontend http_in
    bind *:{{ haproxy_port }}
    acl host_game  hdr_beg(host) -i dino.
    acl host_graf  hdr_beg(host) -i grafana.
    acl host_prom  hdr_beg(host) -i prometheus.
    use_backend grafana    if host_graf
    use_backend prometheus if host_prom
    default_backend game

    http-request cache-use static if { path_beg /static/ } || { path /api/scores } { method GET }
    http-response cache-store static

    stats enable
    stats uri /haproxy
    stats refresh 5s

backend game
    option httpchk GET /healthz
    timeout check 5s
    server app1 127.0.0.1:5000 check inter 2s fall 5 rise 1 maxconn 256

backend grafana
    server grafana1 127.0.0.1:3000 check inter 5s

backend prometheus
    server prom1 127.0.0.1:9090 check inter 5s
