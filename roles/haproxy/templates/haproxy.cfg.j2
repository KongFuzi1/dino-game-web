# {{ ansible_managed }}
global
    log /dev/log local0
    maxconn 512
    user haproxy
    group haproxy
    daemon

cache static
    total-max-size 64        # MB
    max-object-size 2000000  # bytes
    max-age 120              # seconds

defaults
    log     global
    mode    http
    option  httplog
    option  forwardfor
    timeout connect 5s
    timeout client  30s
    timeout server  30s

frontend http_in
    bind *:{{ haproxy_port }}
    acl host_graf  hdr_dom(host) -i {{ grafana_host }}
    acl host_prom  hdr_dom(host) -i {{ prometheus_host }}

    http-request cache-use static if { path_beg /static/ } || { path /api/scores } { method GET }
    http-response cache-store static

{% if monitoring_enabled %}
    use_backend grafana    if host_graf
    use_backend prometheus if host_prom
{% endif %}
    default_backend game

    stats enable
    stats uri /haproxy
    stats refresh 5s

{% if monitoring_enabled %}
frontend metrics
    bind 127.0.0.1:8405
    http-request use-service prometheus-exporter if { path /metrics }
    no log
{% endif %}

backend game
    option httpchk GET /healthz
    timeout check 5s
    server app1 127.0.0.1:5000 check inter 2s fall 5 rise 1 maxconn 256

{% if monitoring_enabled %}
backend grafana
    server grafana1 127.0.0.1:3000 check inter 5s

backend prometheus
    server prom1 127.0.0.1:9090 check inter 5s
{% endif %}
