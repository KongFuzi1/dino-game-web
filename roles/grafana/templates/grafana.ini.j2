# {{ ansible_managed }}
[server]
http_addr = 127.0.0.1
http_port = 3000
domain = {{ grafana_host }}
root_url = http://{{ grafana_host }}/

[auth.anonymous]
enabled = true
org_role = Viewer

[security]
admin_user = admin
admin_password = {{ grafana_admin_password }}

[analytics]
reporting_enabled = false
check_for_updates = false

[dashboards]
default_home_dashboard_path = /var/lib/grafana/dashboards/dino.json

[plugins]
preinstall_disabled = true
